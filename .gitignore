# ==========================================
# Databricks Specific Exclusions
# ==========================================
.databricks/
databricks.local.yml
*.dbfs
*.ephemeral
.ipynb_checkpoints/
.bndl/

# ==========================================
# Standard Python Template
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
pythonenv*/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Environment Variables and Secrets (CRITICAL)
.env
.env.local
.secret
secrets.json

# Default .gitignore content added by dbt Cloud# you shouldn't commit these into source control
# these are the default directory names, adjust/add to fit your needs
target/
dbt_packages/
logs/
# end dbt Cloud content
